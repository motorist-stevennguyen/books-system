<% features.each_slice(2) do |row| %>
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="">
		<tr style="display:flex;justify-content:space-between">
			<% row.each do |feature| %>
				<td width="calc(50% - 42px)" valign="top" style="padding:16px;background-color:#f7d4b829;margin:5px;border-radius:8px;width:calc(50% - 42px)">
					<div style="margin:8px 0;width:100%;height:96px;border-radius:8px;overflow:hidden"><img vspace="0" hspace="0"
							src="<%= attachments['logo.jpg'].url %>"
							alt="Icon Road Tax" width="100%" height="100%"/></div>
					<p style="margin:0 0 4px;font-size:14px; font-weight:600; color:#1A1A1A;display:-webkit-box;overflow:clip;-webkit-line-clamp:1;-webkit-box-orient:vertical">[<%= feature.code %>]<%= feature.title %></p>
					<p style="margin:0; font-size:14px; line-height:1.5; color:#6B6560;">Author: <%= feature.author.name %></p>
					<p style="margin:0; font-size:14px; line-height:1.5; color:#6B6560;">Published at: <%= feature.published_date %></p>
					<p style="margin:0; font-size:14px; line-height:1.5; color:#6B6560;"><i><%= feature.description %></i></p>
					<p style="margin:0; font-size:14px; line-height:1.5; color:#6B6560;">Pages: <a style="color: green"><%= feature.pages %></a>, Language: <a style="color: green"><%= feature.language %></a></p>
				</td>
			<% end %>
		</tr>
	</table>
<% end %>
