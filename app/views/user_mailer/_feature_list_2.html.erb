<% features.each do |feature| %>
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="feature-row" style="margin:0 0 18px; background-color:#022357; border-radius:10px; border:1px solid #0a2f66;">
		<tr>
			<td width="180" valign="top" style="padding:16px 0 16px 16px; line-height:0; font-size:0;">
				<img src="<%= attachments['book.jpg'].url %>" alt="<%= feature.title %>" width="160" height="200" style="display:block; width:160px; height:200px; object-fit:cover; border-radius:8px; background-color:#EDE2D3;">
				<span style="display:inline-block; padding:2px 8px; font-size:11px; font-weight:600; letter-spacing:0.04em; color:#d1ad33; background-color:#5c5f7f94; border-radius:4px; text-transform:uppercase;">book image</span>
			</td>
			<td valign="top" style="padding:16px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
					<tr>
						<td style="padding:0 0 6px;">
							<span style="display:inline-block; padding:2px 8px; font-size:11px; font-weight:600; letter-spacing:0.04em; color:#d1ad33; background-color:#5c5f7f94; border-radius:4px; text-transform:uppercase;"><%= feature.code %></span>
						</td>
					</tr>
					<tr>
						<td style="padding:0 0 4px;">
							<p style="margin:0; font-size:17px; line-height:1.4; font-weight:700; color:#d1ad33;">
								<%= feature.title %>
							</p>
						</td>
					</tr>
					<tr>
						<td style="padding:0 0 6px;">
							<p style="margin:0; font-size:13px; line-height:1.5; color:#d1ad33;">
								by <%= feature.author.name %> <%= feature.author.nationality %> <%= feature.published_date.strftime("%B %d, %Y") %>
							</p>
						</td>
					</tr>
					<tr>
						<td style="padding:0 0 10px;">
							<p style="margin:0; font-size:13px; line-height:1.6; color:#d1ad33;">
								<%= truncate(feature.description, length: 260) %>
							</p>
						</td>
					</tr>
					<tr>
						<td style="padding:0 0 10px;">
							<table role="presentation" cellpadding="0" cellspacing="0" border="0">
								<tr>
									<% feature.category.each do |c| %>
										<td style="padding:0 6px 6px 0;">
											<span style="display:inline-block; padding:3px 10px; font-size:11px; line-height:1.4; color:#d1ad33; background-color:#5c5f7f94; border:1px solid #EDE2D3; border-radius:12px;"><%= c.name.downcase %></span>
										</td>
									<% end %>
								</tr>
							</table>
						</td>
					</tr>
					<tr>
						<td style="border-top:1px solid #EDE2D3; padding:10px 0 10px;">
							<p style="margin:0; font-size:12px; line-height:1.5; color:#d1ad33;">
								<%= feature.pages %> pages <%= feature.language %> est. <%= (feature.pages / 40.0).ceil %> hr read
							</p>
						</td>
					</tr>
					<tr>
						<td>
							<a href="<%= @url %>" style="display:inline-block; padding:9px 22px; font-size:12px; font-weight:600; color:#d1ad33; border:1px solid #d1ad33; border-radius:6px; text-decoration:none;">Add to my list</a>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
<% end %>
