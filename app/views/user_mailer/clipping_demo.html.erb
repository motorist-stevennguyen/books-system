<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F7F5F1;">
	<tr>
		<td align="center" style="padding:40px 16px;">
			<table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" class="stack-column" style="max-width:560px; width:100%;">

				<tr>
					<td style="padding-bottom:24px; border-bottom:2px solid #A6402F;">
						<span style="font-size:16px; font-weight:700; letter-spacing:0.02em; color:#1A1A1A;"><%= UserMailer::BRAND_NAME %></span>
					</td>
				</tr>

				<tr>
					<td class="mobile-pad" style="padding:28px 0 4px;">
						<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#1A1A1A;">
							Hi <%= @user.first_name.presence || "there" %>,
						</p>
						<p style="margin:0; font-size:14px; line-height:1.6; color:#6B6560;">
							Gmail clipping demo: this message repeats the list below
							<%= @block_count %> times so the HTML part crosses Gmail's ~102KB
							(104,448 byte) clipping limit. In a real Gmail inbox, everything past
							that point is replaced with "[Message clipped] View entire message,"
							and the "Log in" button below won't render until the reader clicks
							through.
						</p>
					</td>
				</tr>

				<tr>
					<td class="mobile-pad" style="padding:8px 0;">
						<% @block_count.times do %>
							<%= render "feature_list", features: UserMailer::FEATURES.first(3) %>
						<% end %>
					</td>
				</tr>

				<tr>
					<td class="mobile-pad" style="padding:28px 0 8px;">
						<table role="presentation" cellpadding="0" cellspacing="0" border="0">
							<tr>
								<td style="background-color:#A6402F;">
									<a href="<%= @url %>" style="display:inline-block; padding:11px 24px; font-size:14px; font-weight:600; color:#FFFFFF;">
										Log in
									</a>
								</td>
							</tr>
						</table>
					</td>
				</tr>

				<tr>
					<td class="mobile-pad" style="padding:32px 0 0;">
						<p style="margin:0; font-size:12px; color:#9A9488; line-height:1.6;">
							You're getting this email because you signed up for <%= UserMailer::BRAND_NAME %>.
							<a href="#" style="color:#9A9488; text-decoration:underline;">Unsubscribe</a>
						</p>
					</td>
				</tr>

			</table>
		</td>
	</tr>
</table>
