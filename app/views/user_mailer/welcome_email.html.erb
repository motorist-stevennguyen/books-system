<span style="display:none; font-size:1px; color:#F7F5F1; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;">
	Thanks for creating a <%= UserMailer::NAME %> account.
</span>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F7F5F1;">
	<tr>
		<td align="center" style="padding:40px 16px;">
			<table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" class="stack-column" style="max-width:560px; width:100%;">

				<tr>
					<td style="padding-bottom:24px; border-bottom:2px solid #A6402F;">
						<span style="font-size:16px; font-weight:700; letter-spacing:0.02em; color:#1A1A1A;"><%= UserMailer::NAME %></span>
					</td>
				</tr>

				<tr>
					<td class="mobile-pad" style="padding:28px 0 4px;">
						<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#1A1A1A;">
							Hi <%= @user.first_name.presence || "there" %>,
						</p>
						<p style="margin:0; font-size:15px; line-height:1.6; color:#1A1A1A;">
							Thanks for creating a <%= UserMailer::NAME %> account. Here's what's waiting for you:
						</p>
					</td>
				</tr>

				<tr>
					<td class="mobile-pad" style="padding:8px 0;">
						<%= render "feature_list", features: @books %>
					</td>
				</tr>

			</table>
		</td>
	</tr>
</table>
