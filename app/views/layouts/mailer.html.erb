<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="format-detection" content="telephone=no,url=no"/>
		<meta name="color-scheme" content="light">
		<style>
			body, table, td { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
			body { margin: 0; padding: 0; background-color: #F7F5F1; -webkit-text-size-adjust: 100%; }
			table { border-collapse: collapse; }
			img { border: 0; display: block; }
			a { text-decoration: none; }

			@media screen and (max-width: 480px) {
				.stack-column { width: 100% !important; }
				.mobile-pad { padding-left: 20px !important; padding-right: 20px !important; }
			}
		</style>
	</head>
	<body style="margin:0; padding:0; background-color:#F7F5F1;">
		<%= yield %>
	</body>
</html>
